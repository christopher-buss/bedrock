{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"enabledManagers": ["npm", "github-actions", "mise"],
	"ignorePaths": [
		"**/node_modules/**",
		"**/vendor/**",
		"**/fixtures/**",
		"**/__fixtures__/**",
		".agents/**",
		".claude/**",
		".codex/**"
	],
	"separateMinorPatch": true,
	"automerge": false,
	"automergeType": "pr",
	"automergeStrategy": "squash",
	"platformAutomerge": false,
	"platformCommit": "enabled",
	"gitIgnoredAuthors": ["355930863+bedrock-rbx-intents[bot]@users.noreply.github.com"],
	"ignoreTests": false,
	"packageRules": [
		{ "matchDatasources": ["npm"], "minimumReleaseAge": "1 day" },
		{
			"description": "Release the oxc toolchain together",
			"matchPackageNames": [
				"oxlint",
				"oxlint-*",
				"@oxlint/**",
				"oxfmt",
				"oxfmt-*",
				"oxc-*",
				"@oxc-*/**"
			],
			"groupName": "oxc",
			"groupSlug": "oxc"
		},
		{
			"description": "Batch non-breaking patches into one PR; automerge held off for the change intent writer pilot",
			"matchUpdateTypes": ["patch"],
			"matchIsBreaking": false,
			"matchPackageNames": ["!@stryker-mutator/**", "!@vitest/eslint-plugin"],
			"groupName": "patch updates",
			"groupSlug": "all-patch",
			"automerge": false
		},
		{
			"description": "Pins and digests carry no isBreaking, so match them apart",
			"matchUpdateTypes": ["pin", "pinDigest", "digest"],
			"matchPackageNames": ["!@stryker-mutator/**", "!@vitest/eslint-plugin"],
			"groupName": "patch updates",
			"groupSlug": "all-patch",
			"automerge": false
		},
		{
			"description": "Patched dependencies",
			"matchPackageNames": ["@stryker-mutator/**", "@vitest/eslint-plugin"],
			"prBodyNotes": [
				"This update includes a package with a version-pinned entry in `patchedDependencies`. Run `pnpm patch` on each new version, apply the patch again, run `pnpm patch-commit`, then delete the old patch file."
			]
		}
	],
	"prConcurrentLimit": 5,
	"reviewers": [],
	"additionalReviewers": [],
	"assignees": [],
	"semanticCommits": "enabled",
	"semanticCommitType": "chore",
	"semanticCommitScope": "deps"
}
