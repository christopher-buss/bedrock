{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"enabledManagers": ["npm", "github-actions", "mise"],
	"ignorePaths": [
		"**/node_modules/**",
		"**/vendor/**",
		"**/fixtures/**",
		"**/__fixtures__/**",
		".agents/**",
		".claude/**",
		".codex/**"
	],
	"separateMinorPatch": true,
	"automerge": false,
	"automergeType": "pr",
	"automergeStrategy": "squash",
	"platformAutomerge": false,
	"platformCommit": "enabled",
	"ignoreTests": false,
	"packageRules": [
		{ "matchDatasources": ["npm"], "minimumReleaseAge": "1 day" },
		{
			"description": "Release the oxc toolchain together",
			"matchPackageNames": [
				"oxlint",
				"oxlint-*",
				"@oxlint/**",
				"oxfmt",
				"oxfmt-*",
				"oxc-*",
				"@oxc-*/**"
			],
			"groupName": "oxc",
			"groupSlug": "oxc"
		},
		{
			"description": "Batch non-breaking patches into one automerged PR",
			"matchUpdateTypes": ["patch"],
			"matchIsBreaking": false,
			"groupName": "patch updates",
			"groupSlug": "all-patch",
			"automerge": true
		},
		{
			"description": "Pins and digests carry no isBreaking, so match them apart",
			"matchUpdateTypes": ["pin", "pinDigest", "digest"],
			"groupName": "patch updates",
			"groupSlug": "all-patch",
			"automerge": true
		}
	],
	"prConcurrentLimit": 5,
	"reviewers": [],
	"additionalReviewers": [],
	"assignees": [],
	"semanticCommits": "enabled",
	"semanticCommitType": "chore",
	"semanticCommitScope": "deps"
}
