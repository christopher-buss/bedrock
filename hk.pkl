amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

min_hk_version = "2.12.0"

// Agent detection: prints "true" if running inside an AI agent (Claude, Cursor, etc.)
local isAgent: String = #"exec("bun scripts/is-agent.ts") == "true""#

local preCommitBranchGuard = new Step {
    check = "hk util no-commit-to-branch --branch main"
}

local sharedGuards = new Mapping<String, Step> {
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["detect-private-key"] = Builtins.detect_private_key
    ["check-added-large-files"] = (Builtins.check_added_large_files) {
        exclude = List("pnpm-lock.yaml", "packages/*/vendor/**")
    }
    ["check-symlinks"] = new Step {
        check = "bun scripts/check-symlinks.ts"
    }
    ["check-renovate-patches"] = new Step {
        glob = List("pnpm-workspace.yaml", ".github/renovate.json")
        check = "bun scripts/check-renovate-patches.ts"
    }
}

// Base checker steps — used directly by `hk check`, conditioned for hooks
local genExampleTests = new Step {
    check = "pnpm gen:example-tests"
    exclusive = true
}

// `package-json/valid-repository-directory` shells out to `git rev-parse
// --show-toplevel`, inheriting the hook's exported git env. `GIT_DIR` makes
// every package resolve as its own toplevel, so `repository.directory` never
// matches. Clearing them restores worktree discovery from the cwd.
local lint = new Step {
	check = "bun scripts/without-git-environment.ts pnpm lint:affected"
	fix = "bun scripts/without-git-environment.ts pnpm lint:affected --fix"
}

local typecheck = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm typecheck:affected"
	stomp = true
}

local test = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm test:affected"
    exclusive = true
}

// CI variant of `test` — runs with coverage and merges reports. Used only by the
// `check` hook so local hooks (pre-commit/pre-push) stay fast.
local testCi = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm test:ci"
    exclusive = true
}

// Exclusive: the `examples/ci-codegen` build and typecheck both run rbxtsc, which
// rewrites `include/`. Run in parallel on Windows, they fail with EBUSY.
local build = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm build:affected"
    exclusive = true
}

local mutate = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm mutate:changed"
    exclusive = true
}

// Pre-push variant of `mutate` that scopes against `origin/main`, mirroring
// the CI mutation job. Pre-commit's `mutate` only sees the current slice; a
// survivor exposed by a later slice's tests would slip past without this.
local mutatePush = new Step {
    glob = List("*.ts", "*.tsx")
    check = "pnpm mutate:changed"
    env {
        ["MUTATE_BASE_REF"] = "origin/main"
    }
    exclusive = true
}

local unused = new Step {
    glob = List("*.ts", "*.tsx", "package.json", "pnpm-workspace.yaml")
    check = "pnpm lint:unused"
    exclusive = true
}

hooks {
    ["pre-commit"] {
		fix = true
        stash = "none"
        steps {
            ...sharedGuards
            ["no-commit-to-branch"] = preCommitBranchGuard
            ["typecheck"] = (typecheck)
            ["build"] = (build) { condition = isAgent }
			["lint"] = (lint)
            ["gen-example-tests"] = (genExampleTests) { condition = isAgent }
            ["test"] = (test) { condition = isAgent }
            ["mutate"] = (mutate) { condition = isAgent }
        }
    }
    ["pre-push"] {
        steps {
            ["typecheck"] = typecheck
            ["build"] = build
            ["unused"] = unused
			["lint"] = lint
            ["gen-example-tests"] = genExampleTests
            ["test"] = test
            ["mutate"] = (mutatePush) { condition = isAgent }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm commitlint --edit {{commit_msg_file}}"
            }
        }
    }
    ["post-merge"] {
        steps {
            ["install-deps"] {
                glob = List("pnpm-lock.yaml")
                check = "pnpm install"
            }
            ["mise-install"] {
                glob = List("mise.toml")
                check = "mise install"
            }
        }
    }
    ["check"] {
        steps {
            ...sharedGuards
            ["typecheck"] = typecheck
            ["build"] = build
            ["unused"] = unused
			["lint"] = lint
            ["gen-example-tests"] = genExampleTests
            ["test"] = testCi
        }
    }
}
