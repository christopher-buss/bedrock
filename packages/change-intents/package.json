{
	"name": "@bedrock-rbx/change-intents",
	"private": true,
	"description": "Native pnpm change intents for Renovate",
	"keywords": [
		"changesets",
		"dependencies",
		"renovate"
	],
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"type": "module",
	"imports": {
		"#src/*": "./src/*.ts",
		"#tests/*": "./tests/*.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vp test",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"confbox": "catalog:runtime",
		"npm-package-arg": "catalog:script",
		"semver": "catalog:script"
	},
	"devDependencies": {
		"@bedrock-rbx/testing": "workspace:*",
		"@bedrock-rbx/typescript-config": "workspace:*",
		"@bedrock-rbx/vite-config": "workspace:*",
		"@stryker-mutator/api": "catalog:test",
		"@stryker-mutator/core": "catalog:test",
		"@stryker-mutator/typescript-checker": "catalog:test",
		"@stryker-mutator/vitest-runner": "catalog:test",
		"@types/bun": "catalog:types",
		"@types/npm-package-arg": "catalog:types",
		"@types/semver": "catalog:types",
		"typescript": "catalog:tsc",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.12.0",
		"bun": ">=1.3.0"
	}
}
