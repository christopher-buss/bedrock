{
	"extends": "@bedrock-rbx/typescript-config/tsconfig.base.json",
	"compilerOptions": {
		// Vite bundles the site, so tsc never emits or rewrites its imports.
		"rewriteRelativeImportExtensions": false
	},
	"include": [".vitepress/**/*", "docs/**/*", "landing/**/*", "vite.config.ts"],
	"exclude": ["node_modules", ".vitepress/cache", ".vitepress/dist"]
}
