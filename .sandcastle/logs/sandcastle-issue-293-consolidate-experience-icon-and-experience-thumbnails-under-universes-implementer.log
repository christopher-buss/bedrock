Bash(mkdir -p ~/.local/bin && cat > ~/.local/bin/ps << 'EOF'
#!/bin/bash
# Minimal ps shim for tree-kill which calls: ps -o pid --no-headers --ppid <pid>
# Reads /proc to find children of a given pid.
parent_pid=""
for arg in "$@"; do
    case "$prev" in
        --ppid) parent_pid="$arg" ;;
    esac
    prev="$arg"
done

if [ -z "$parent_pid" ]; then
    exit 1
fi

found=0
for pid_dir in /proc/[0-9]*; do
    pid=$(basename "$pid_dir")
    if [ -r "$pid_dir/stat" ]; then
        # /proc/<pid>/stat: pid (comm) state ppid ...
        # Extract ppid (4th field, but comm contains parens)
        ppid=$(awk '{
            for (i=NF; i>=1; i--) {
                if ($i ~ /^[0-9]+$/) continue
                if ($i ~ /\)$/) { print $(i+2); exit }
            }
        }' "$pid_dir/stat" 2>/dev/null)
        if [ "$ppid" = "$parent_pid" ]; then
            echo "$pid"
            found=1
        fi
    fi
done

# Exit 0 if found children, 1 if none
[ "$found" = "1" ]
EOF
chmod +x ~/.local/bin/ps
which ps && ps -o pid --no-headers --ppid 1 | head -3)
