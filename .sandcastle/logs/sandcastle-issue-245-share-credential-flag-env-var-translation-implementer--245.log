import { describe, expect, it, vi } from "vitest";

import { withCredentialOverrides } from "./credential-environment.ts";

describe(withCredentialOverrides, () => {
	it("should resolve BEDROCK_API_KEY to flags.apiKey when supplied", () => {
		expect.assertions(2);

		const baseReader = vi.fn<(name: string) => string | undefined>(() => undefined);
		const reader = withCredentialOverrides({ apiKey: "rbx-flag" }, baseReader);

		expect(reader("BEDROCK_API_KEY")).toBe("rbx-flag");
		expect(baseReader).not.toHaveBeenCalledWith("BEDROCK_API_KEY");
	});

	it("should resolve GITHUB_TOKEN to flags.githubToken when supplied", () => {
		expect.assertions(2);

		const baseReader = vi.fn<(name: string) => string | undefined>(() => undefined);
		const reader = withCredentialOverrides({ githubToken: "ghp-flag" }, baseReader);

		expect(reader("GITHUB_TOKEN")).toBe("ghp-flag");
		expect(baseReader).not.toHaveBeenCalledWith("GITHUB_TOKEN");
	});

	it("should fall through to the base reader when the named flag is undefined", () => {
		expect.assertions(2);

		const baseValues = new Map([
			["BEDROCK_API_KEY", "from-base-bedrock"],
			["GITHUB_TOKEN", "from-base-github"],
		]);
		const reader = withCredentialOverrides({}, (name) => baseValues.get(name));

		expect(reader("BEDROCK_API_KEY")).toBe("from-base-bedrock");
		expect(reader("GITHUB_TOKEN")).toBe("from-base-github");
	});

	it("should fall through to the base reader for unrelated env-var names", () => {
		expect.assertions(2);

		const reader = withCredentialOverrides(
			{ apiKey: "rbx-flag", githubToken: "ghp-flag" },
			(name) => (name === "UNRELATED_VAR" ? "from-base" : undefined),
		);

		expect(reader("UNRELATED_VAR")).toBe("from-base");
		expect(reader("ANOTHER")).toBeUndefined();
	});
});
SPECEOF
