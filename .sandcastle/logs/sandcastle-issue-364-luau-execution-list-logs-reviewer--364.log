#!/usr/bin/env bash
# Minimal ps shim for environments without procps. Implements just the
# `ps -o pid --no-headers --ppid <pid>` form that Stryker (via tree-kill)
# uses for process supervision. Walks /proc to find child PIDs.
target_ppid=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --ppid)
            target_ppid="$2"
            shift 2
            ;;
        --no-headers|-o|pid)
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z "$target_ppid" ]]; then
    exit 1
fi

shopt -s nullglob
found=0
for status_file in /proc/[0-9]*/status; do
    ppid_line=$(grep -m1 '^PPid:' "$status_file" 2>/dev/null) || continue
    ppid="${ppid_line##*$'\t'}"
    if [[ "$ppid" == "$target_ppid" ]]; then
        pid_line=$(grep -m1 '^Pid:' "$status_file" 2>/dev/null) || continue
        pid="${pid_line##*$'\t'}"
        echo "$pid"
        found=1
    fi
done

# Match real `ps` behavior: exit 1 when --ppid has no matching children.
[[ $found -eq 1 ]] || exit 1
EOF
