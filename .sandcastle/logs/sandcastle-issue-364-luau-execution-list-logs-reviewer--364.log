#!/usr/bin/env bash
# Minimal ps shim for environments without procps. Implements just the
# `ps -o pid --no-headers --ppid <pid>` form that Stryker uses for
# process supervision. Walks /proc to find child PIDs of the given ppid.
target_ppid=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --ppid)
            target_ppid="$2"
            shift 2
            ;;
        --no-headers|-o|pid)
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z "$target_ppid" ]]; then
    exit 0
fi

shopt -s nullglob
for status_file in /proc/[0-9]*/status; do
    ppid_line=$(grep -m1 '^PPid:' "$status_file" 2>/dev/null) || continue
    ppid="${ppid_line##*$'\t'}"
    if [[ "$ppid" == "$target_ppid" ]]; then
        pid_line=$(grep -m1 '^Pid:' "$status_file" 2>/dev/null) || continue
        pid="${pid_line##*$'\t'}"
        echo "$pid"
    fi
done
EOF
chmod +x ~/.local/bin/ps && ps -o pid --no-headers --ppid 1 2>&1 | head -5)
