Bash(cat > /home/agent/bin/ps <<'PSEOF'
#!/bin/bash
# Minimal ps wrapper for Stryker/tree-kill in environments without procps
# Handles: ps -o pid --no-headers --ppid <ppid>
args=("$@")
ppid=""
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    --ppid) ppid="${args[$((i+1))]}"; ;;
  esac
done
if [[ -n "$ppid" ]]; then
  found=0
  for dir in /proc/[0-9]*/; do
    pid="${dir:6:-1}"
    stat_file="$dir/stat"
    [[ -r "$stat_file" ]] || continue
    read -r _ _ _ parent _ < "$stat_file" 2>/dev/null || continue
    if [[ "$parent" == "$ppid" ]]; then
      echo "$pid"
      found=1
    fi
  done
  # Exit 1 when no children (matches real ps behavior)
  [[ $found -eq 0 ]] && exit 1
  exit 0
fi
exit 1
PSEOF
