Stryker needs `ps`. Let me create a minimal wrapper using `/proc`:
Bash(mkdir -p /home/agent/bin && cat > /home/agent/bin/ps <<'PSEOF'
#!/bin/bash
# Minimal ps wrapper for Stryker in environments without procps
# Handles: ps -o pid --no-headers --ppid <ppid>
args=("$@")
ppid=""
output_pid=false
no_headers=false
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    --ppid) ppid="${args[$((i+1))]}"; i=$((i+1)) ;;
    -o) [[ "${args[$((i+1))]}" == "pid" ]] && output_pid=true; i=$((i+1)) ;;
    --no-headers) no_headers=true ;;
  esac
done
if [[ -n "$ppid" ]]; then
  for dir in /proc/[0-9]*/; do
    pid="${dir:6:-1}"
    stat_file="$dir/stat"
    [[ -r "$stat_file" ]] || continue
    read -r _ _ _ parent _ < "$stat_file" 2>/dev/null || continue
    [[ "$parent" == "$ppid" ]] && echo "$pid"
  done
  exit 0
fi
exit 0
PSEOF
