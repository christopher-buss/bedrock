Bash(cat > /home/agent/.local/bin/ps <<'EOF'
#!/bin/bash
# Minimal ps shim for Stryker child-process management via tree-kill.
# Stryker invokes: ps -o pid --no-headers --ppid <PPID>
# tree-kill@1.2.2 has a bug where empty stdout + exit 0 throws on null
# .match(); we exit non-zero with no output to dodge that branch.
ppid_target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ppid) ppid_target="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ -z "$ppid_target" ]; then
  exit 1
fi
found=0
for pid_dir in /proc/[0-9]*; do
  [ -r "$pid_dir/stat" ] || continue
  read -r _pid _comm _state ppid _rest < "$pid_dir/stat"
  if [ "$ppid" = "$ppid_target" ]; then
    echo "$_pid"
    found=1
  fi
done
if [ "$found" = "0" ]; then
  exit 1
fi
EOF
chmod +x /home/agent/.local/bin/ps)
