#!/bin/bash
# Minimal ps shim for Stryker child-process management.
# Stryker invokes: ps -o pid --no-headers --ppid <PPID>
ppid_target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ppid) ppid_target="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ -z "$ppid_target" ]; then
  exit 0
fi
for pid_dir in /proc/[0-9]*; do
  [ -r "$pid_dir/stat" ] || continue
  read -r _pid _comm _state ppid _rest < "$pid_dir/stat"
  if [ "$ppid" = "$ppid_target" ]; then
    echo "$_pid"
  fi
done
EOF
chmod +x /home/agent/.local/bin/ps && export PATH=/home/agent/.local/bin:$PATH && ps -o pid --no-headers --ppid 1 | head -3)
