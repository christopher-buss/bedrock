#!/bin/sh
# Minimal ps implementation for environments without procps
# Supports: ps -o pid --no-headers --ppid <ppid>
# All other flags: fall through to /proc

if [ "$1" = "-o" ] && [ "$2" = "pid" ] && [ "$3" = "--no-headers" ] && [ "$4" = "--ppid" ]; then
    ppid="$5"
    for dir in /proc/[0-9]*; do
        pid="${dir#/proc/}"
        stat_file="/proc/$pid/stat"
        if [ -f "$stat_file" ]; then
            read -r stat_line < "$stat_file" 2>/dev/null || continue
            # stat format: pid (name) state ppid ...
            # extract ppid (4th field)
            parent=$(echo "$stat_line" | awk '{print $4}')
            if [ "$parent" = "$ppid" ]; then
                echo "$pid"
            fi
        fi
    done
    exit 0
fi

# Unknown flags: exit 0 to avoid breaking callers
exit 0
EOF
chmod +x /home/agent/.local/bin/ps)
