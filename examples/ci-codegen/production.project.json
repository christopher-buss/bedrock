{
	"name": "bedrock-example",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"rbxts_include": { "$path": "include" },
			"shared": { "$path": "out/shared" }
		},
		"ServerScriptService": {
			"server": { "$path": "out/server" }
		}
	}
}
