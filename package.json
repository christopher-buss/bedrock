{
	"name": "@bedrock-rbx/bedrock",
	"version": "0.0.0",
	"private": true,
	"description": "IaC for Roblox deployment",
	"keywords": [
		"infrastructure",
		"roblox",
		"deployment"
	],
	"homepage": "https://github.com/christopher-buss/bedrock#readme",
	"bugs": "https://github.com/christopher-buss/bedrock/issues",
	"repository": {
		"url": "git+https://github.com/christopher-buss/bedrock.git",
		"type": "git"
	},
	"license": "MIT",
	"author": "Christopher Buss <christopher.buss@pm.me> (https://github.com/christopher-buss)",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:affected": "vp run -r build",
		"commit": "commit",
		"dev": "vp run -r dev",
		"docs:build": "pnpm --filter @bedrock-rbx/website run docs:build",
		"docs:dev": "pnpm --filter @bedrock-rbx/website run docs:dev",
		"eslint-config": "eslint-config-inspector",
		"gen:example-tests": "bun scripts/generate-example-tests.ts",
		"lint": "isentinel-lint",
		"lint:affected": "eslint --cache .",
		"lint:unused": "knip --cache",
		"mutate:changed": "bun scripts/mutate-changed.ts",
		"release": "pnpm build && pnpm publish -r",
		"test": "vp test",
		"test:affected": "vp test",
		"test:ci": "vp test --coverage",
		"test:smoke": "pnpm --filter @bedrock-rbx/e2e test:smoke",
		"test:watch": "vp test --watch",
		"typecheck": "vp run -r --no-cache typecheck && pnpm typecheck:root",
		"typecheck:affected": "vp run -r --no-cache typecheck && pnpm typecheck:root",
		"typecheck:root": "tsgo --noEmit -p scripts && tsgo --noEmit -p tsconfig.root.json"
	},
	"devDependencies": {
		"@bedrock-rbx/core": "workspace:*",
		"@bedrock-rbx/testing": "workspace:*",
		"@bedrock-rbx/vite-config": "workspace:*",
		"@commitlint/cli": "catalog:lint",
		"@commitlint/config-conventional": "catalog:lint",
		"@commitlint/config-pnpm-scopes": "catalog:lint",
		"@commitlint/prompt-cli": "catalog:lint",
		"@commitlint/types": "catalog:lint",
		"@eslint/config-inspector": "catalog:lint",
		"@isentinel/eslint-config": "catalog:lint",
		"@isentinel/hooks": "catalog:lint",
		"@isentinel/tsconfig": "catalog:tsc",
		"@types/bun": "catalog:types",
		"@typescript-eslint/parser": "catalog:lint",
		"@typescript/native-preview": "catalog:types",
		"@vitest/coverage-v8": "catalog:test",
		"@vitest/eslint-plugin": "catalog:lint",
		"better-typescript-lib": "catalog:tsc",
		"eslint": "catalog:lint",
		"eslint-merge-processors": "catalog:lint",
		"eslint-plugin-erasable-syntax-only": "catalog:lint",
		"eslint-plugin-jest-extended": "catalog:lint",
		"eslint-plugin-n": "catalog:lint",
		"eslint-plugin-pnpm": "catalog:lint",
		"eslint-plugin-vue": "catalog:lint",
		"eslint-plugin-vuejs-accessibility": "catalog:lint",
		"eslint-processor-vue-blocks": "catalog:lint",
		"eslint_d": "catalog:dev",
		"file-entry-cache": "catalog:dev",
		"generate-jsdoc-example-tests": "catalog:test",
		"get-tsconfig": "catalog:dev",
		"jiti": "catalog:script",
		"knip": "catalog:lint",
		"madge": "catalog:dev",
		"oxc-minify": "catalog:dev",
		"oxlint-tsgolint": "catalog:lint",
		"pncat": "catalog:dev",
		"publint": "catalog:lint",
		"std-env": "catalog:script",
		"typescript": "catalog:tsc",
		"unplugin-unused": "catalog:build",
		"vite-plus": "catalog:build",
		"vitest": "catalog:test",
		"vue-eslint-parser": "catalog:lint"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=24.12.0"
	}
}
